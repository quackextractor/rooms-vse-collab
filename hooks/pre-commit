#!/bin/sh
set -e

# This file runs from hooks/ and, once installed, from .git/hooks/, where rev-parse has no work tree.
hook_dir=$(cd "$(dirname "$0")" && pwd)

case "$hook_dir" in
    */.git/hooks) repo_root=$(cd "$hook_dir/../.." && pwd) ;;
    *)            repo_root=$(git -C "$hook_dir" rev-parse --show-toplevel) ;;
esac

if [ ! -e "$repo_root/.git" ]; then
    echo "[ERROR] $hook_dir is not inside a git work tree. Nothing to check."
    exit 1
fi

cd "$repo_root"

echo "[INFO] building and testing"

if ! sh scripts/build.sh; then
    echo ""
    echo "[ERROR] the build failed. The commit was not made."
    echo "        Fix it, or run 'sh scripts/build.sh' on its own to see the compiler's output."
    exit 1
fi

if ! sh scripts/test.sh; then
    echo ""
    echo "[ERROR] the tests failed. The commit was not made."
    echo "        Run 'sh scripts/test.sh' on its own and read out/test/test.log."
    exit 1
fi

exit 0
