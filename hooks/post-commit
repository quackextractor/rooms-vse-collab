#!/bin/sh
#
# Post-commit: keep CHANGELOG.md's reference links pointing at real releases.
#
# Installed by install-hooks.ps1; the tracked copy lives in hooks/ beside pre-commit. .git/hooks is not
# in the repository, so a fresh clone has to run the installer once before its first commit.
#
# --------------------------------------------------------------------------------------------
# WHAT THIS DOES NOT DO, AND WHY
#
# It does not tag, and it does not publish. Publishing is GitHub Actions' job now
# (.github/workflows/release.yml), which is the only place that can safely do it: a local post-commit
# fires before the commit is on the remote, so a tag pushed from here points at an object GitHub has
# never seen and the release renders with its source missing. The workflow runs after the push, where
# tagging means what it says.
#
# Tags therefore belong to CI alone. An earlier version of this hook created them locally, which is
# how a local v0.1.0 and a CI v0.1.0 end up on two different commits and `git fetch --tags` refuses to
# reconcile them. Nothing here writes a tag.
#
# It cannot refuse a commit either - that is the whole nature of post-commit, the commit already
# exists by the time this runs. The one thing it does is non-fatal and reversible: the link block is
# rewritten and committed separately, so it reverts on its own.
#
# --------------------------------------------------------------------------------------------
# THE RECURSION GUARD, which is not optional
#
# This hook runs `git commit`, and `git commit` runs post-commit. Without the guard below it would
# rewrite the links, commit, rewrite, commit, until git refused an empty commit. The inner commit
# sets ROOMS_AUTOCOMMIT so the nested invocation returns at the first line.

set -e

if [ -n "$ROOMS_AUTOCOMMIT" ]; then
    exit 0
fi

# Resolved from this file's own location, not from the working directory. git runs a hook with the
# worktree root as its cwd, but this hook is also run by hand, and a script that commits inside
# whichever repository the shell happens to be sitting in is not a thing to leave to chance.
#
# Two shapes, because this file is both a tracked copy under <root>/hooks and the installed copy
# under <root>/.git/hooks. `git rev-parse --show-toplevel` cannot be run from inside .git at all:
# there is no work tree there, so it exits 128.
hook_dir=$(cd "$(dirname "$0")" && pwd)

case "$hook_dir" in
    */.git/hooks) repo_root=$(cd "$hook_dir/../.." && pwd) ;;
    *)            repo_root=$(git -C "$hook_dir" rev-parse --show-toplevel) ;;
esac

if [ ! -e "$repo_root/.git" ]; then
    echo "[ERROR] $hook_dir is not inside a git work tree. Nothing to update."
    exit 1
fi

cd "$repo_root"

# git prints the remote as an https URL ending in .git; the link definitions want the human one.
repo_url=$(git config --get remote.origin.url | sed 's|\.git$||')

# --------------------------------------------------------------------------------------------
# STATE, READ BEFORE ANYTHING IS WRITTEN
#
# The link rewrite commits, and a commit made here would sweep up whatever else was lying around in
# the working tree. So the tree is sampled first, and a dirty tree turns the rewrite into advice.

dirty_before=""
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    dirty_before=1
fi

# --------------------------------------------------------------------------------------------
# THE LINKS
#
# Generated rather than written by hand, because the hand-written version is exactly what shipped in
# this repository's first changelog: a link to a release that had never existed, sitting in the
# document people trust to say what was released. post-commit rewrites the block after every commit,
# so a link cannot outlive the release it names.
#
# Two kinds of link, and the difference is the whole point:
#
#   published   the version has a tag, so the release exists and the link resolves. Tags come from the
#               remote after `git fetch --tags`, which is why an older version keeps its link across a
#               clone that has fetched.
#   pending     the version is the newest heading in the changelog and has no tag yet. The release is
#               made by CI from the next push, so the link is written now and resolves a moment after
#               the commit lands. Writing it here rather than waiting a release cycle is what stops
#               `## [0.2.0]` from sitting at the top of the file as literal bracket text for a week.
#
# A version that is neither - older, untagged, not the newest - gets no link at all, which is what a
# link to a release that does not exist looks like.

newest_version=$(grep -a -o '^## \[[0-9][^]]*\]' CHANGELOG.md \
    | head -1 \
    | sed 's/^## \[//; s/\]$//')

if [ -z "$newest_version" ]; then
    echo "[INFO]  post-commit: CHANGELOG.md has no released version heading, nothing to link."
    exit 0
fi

# Only for a remote the links can resolve against. A local path or an ssh remote produces
# `C:/src/repo/releases/tag/v0.1.0`, which is not a URL - and writing one anyway produced a block
# that could not be recognised as generated on the next run, so it was appended again and again.
case "$repo_url" in
    http://* | https://*)
        block="[Unreleased]: $repo_url/compare/v$newest_version...HEAD
"

        for v in $(grep -a -o '^## \[[0-9][^]]*\]' CHANGELOG.md | sed 's/^## \[//; s/\]$//'); do
            if git rev-parse -q --verify "refs/tags/v$v" > /dev/null 2>&1 || [ "$v" = "$newest_version" ]; then
                block="$block[$v]: $repo_url/releases/tag/v$v
"
            fi
        done
        ;;
    *)
        if [ -n "$repo_url" ]; then
            echo "[INFO]  post-commit: remote is not an http(s) URL, so no changelog links are written."
        fi
        block=""
        ;;
esac

# Strip exactly the definitions this hook writes - one per version heading, plus Unreleased - and
# nothing else. A blanket '^\[...\]:' strip would also delete the reference-style links a changelog is
# likely to carry in its header, and the version-shaped ones in particular: `[1.1.0]: <url>` under
# "based on Keep a Changelog" has the same shape as a release link, and the two are told apart only by
# whether the version is one of this file's own headings.
tmp=CHANGELOG.md.tmp

cp CHANGELOG.md "$tmp"

for v in $(grep -a -o '^## \[[0-9][^]]*\]' CHANGELOG.md | sed 's/^## \[//; s/\]$//') Unreleased; do
    grep -a -v "^\[$v\]: " "$tmp" > "$tmp.next" || true
    mv "$tmp.next" "$tmp"
done

mv "$tmp" CHANGELOG.md

# The block is appended after the strip, never instead of it. An earlier version of this file rebuilt
# the file from the surviving lines and dropped the append, so the hook quietly deleted every link on
# every commit and reported them as correct the second time round - a rewrite that loses data and then
# agrees with itself.
if [ -n "$block" ]; then
    printf '%s' "$block" >> CHANGELOG.md
fi

if [ -z "$(git status --porcelain -- CHANGELOG.md)" ]; then
    echo "[INFO]  post-commit: changelog links are correct."
else
    if [ -n "$dirty_before" ]; then
        echo "[INFO]  post-commit: working tree is not clean, so the changelog links were rewritten"
        echo "[INFO]  but not committed. Commit them yourself, or run .git/hooks/post-commit again."
    else
        git add -- CHANGELOG.md
        ROOMS_AUTOCOMMIT=1 git commit -q -m "chore(release): link CHANGELOG.md to tagged releases

Added by the post-commit hook, as a separate commit so it reverts on its own.
A published version is linked only when its tag exists; the newest version
is linked pending, because the release is made by CI from the next push."
        echo "[OK]   post-commit: changelog links rewritten in a separate commit."
    fi
fi

exit 0